mkdir -p "$ROOT/android/app/src/main/res/drawable"
printf '%s' '' | base64 -d > "$ROOT/android/app/src/main/res/drawable/ic_launcher.jpg"
download_img(){ local name="$1"; local url="$2"; curl -L --fail --retry 3 --silent --show-error "$url" -o "$ROOT/android/app/src/main/res/drawable/$name.jpg"; }

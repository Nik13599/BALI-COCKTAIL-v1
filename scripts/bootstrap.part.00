#!/usr/bin/env bash
set -euo pipefail
ROOT="${1:-generated}"
rm -rf "$ROOT"
mkdir -p "$ROOT"

write_gz(){ local path="$1"; local data="$2"; mkdir -p "$(dirname "$ROOT/$path")"; printf "%s" "$data" | base64 -d | gzip -d > "$ROOT/$path"; }

